@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false

class Movie {
  - title : string
  - language : string
  - durationMinutes : int
  + Movie(title : string)
  + Movie(title : string, language : string, durationMinutes : int)
  + getTitle() : string
  + getLanguage() : string
  + getDurationMinutes() : int
}

class Seat {
  - number : int
  - type : SeatType
  + Seat(number, type)
  + getNumber() : int
  + getType() : SeatType
  + getPrice() : int
}

class Screen {
  - screenNumber : int
  - seats : vector<Seat>
  + Screen(screenNumber, seatCount)
  + getScreenNumber() : int
  + getSeats() : vector<Seat>
}

class Cinema {
  - name : string
  - screens : vector<Screen>
  + Cinema(name)
  + addScreen(screenNumber, seatCount)
  + getName() : string
  + getScreens() : vector<Screen>
}

class Show {
  - showId : int
  - movie : Movie*
  - screen : Screen*
  - startTime : string
  - showSeats : vector<ShowSeat>
  + Show(...)
  + findSeat(number) : ShowSeat*
  + displaySeats()
}

class ShowSeat {
  - seat : Seat*
  - seatStatus : SeatStatus
  + isAvailable() : bool
  + bookSeat() : bool
  + cancelSeat()
}

class Customer {
  - name : string
  - phone : string
  + Customer(name, phone)
  + getName() : string
  + getPhone() : string
}

class Booking {
  - nextBookingId : int {static}
  - bookingId : int
  - show : Show*
  - customer : Customer*
  - bookedSeats : vector<ShowSeat*>
  - bookingAmount : double
  - status : BookingStatus
  - payment : Payment*
  + Booking(...)
  + setPayment(payment)
  + confirm()
  + cancel()
}

abstract class Payment {
  {abstract} + pay(amount : double) : bool
  + getMethodName() : string
}

class UpiPayment {
  + pay(amount : double) : bool
  + getMethodName() : string
}
class CardPayment {
  + pay(amount : double) : bool
  + getMethodName() : string
}
class CashPayment {
  + pay(amount : double) : bool
  + getMethodName() : string
}

class PriceCalculator {
  + calculateTotal(seats) : double
}

class TicketPrinter {
  + print(booking)
}

class BookingService {
  - priceCalculator : PriceCalculator
  - ticketPrinter : TicketPrinter
  - bookings : vector<Booking*>
  + createBooking(customer, show, seatNumbers, payment) : Booking*
  + cancelBooking(bookingId) : bool
  + showTicket(bookingId)
}

Cinema "1" *-- "1..*" Screen : composition
Screen "1" *-- "1..*" Seat : composition
Show "1" o-- "1" Movie : aggregation
Show "1" --> "1" Screen : uses
Show "1" *-- "1..*" ShowSeat : composition
ShowSeat "1" --> "1" Seat : references
Booking "0..*" --> "1" Customer : associated with
Booking "0..*" o-- "1..*" ShowSeat : aggregates
Booking "0..*" --> "0..1" Payment : uses
Payment <|-- UpiPayment : inheritance
Payment <|-- CardPayment : inheritance
Payment <|-- CashPayment : inheritance
BookingService "1" --> "0..*" Booking : manages
BookingService --> PriceCalculator : uses
BookingService --> TicketPrinter : uses
@enduml
